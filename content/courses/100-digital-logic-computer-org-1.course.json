  "label": "Digital Logic & Computer Organization I",
  "track": "Computer Engineering",
  "year": 1,
  "term": "2",
  "order": 100,
  "accent": "moss",
  "recommendedHours": 95,
  "description": "From Boolean algebra to the stored-program computer: gates, combinational and sequential circuits, finite-state machines, binary arithmetic, registers, memory, datapaths and a simple instruction-set architecture.",
  "prerequisites": [
    "discrete-math-logic-1"
  ],
  "outcomes": [
    "Represent and simplify digital logic using Boolean algebra and truth tables.",
    "Design combinational and sequential circuits from specifications.",
    "Explain clocks, state, registers, counters and finite-state machines.",
    "Build up a conceptual CPU from datapath, control, memory and instruction encoding.",
    "Trace machine instructions through a simple processor and connect them to C-level behavior."
  ],
