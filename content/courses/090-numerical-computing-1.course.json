  "recommendedHours": 75,
  "description": "Numerical analysis for computer engineers: floating-point error, root finding, linear systems, interpolation, numerical differentiation/integration and iterative methods implemented as real programs.",
  "prerequisites": [
    "calculus-1",
    "linear-algebra-geometry",
    "c-programming-1"
  ],
  "outcomes": [
    "Explain floating-point representation, rounding and conditioning.",
    "Implement and analyze root-finding algorithms.",
    "Solve linear systems numerically and recognize stability issues.",
    "Approximate functions, derivatives and integrals with quantified error.",
    "Separate mathematical error, floating-point error and implementation error."
  ],
