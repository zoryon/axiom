  "order": 70,
  "accent": "signal",
  "recommendedHours": 115,
  "description": "Deeper C and algorithmic programming: dynamic memory, ownership conventions, generic data structures, recursion, files, modularity, testing and performance-conscious implementation.",
  "prerequisites": [
    "c-programming-1"
  ],
  "outcomes": [
    "Design explicit ownership conventions and manage dynamic memory without leaks or lifetime errors.",
    "Implement core data structures from scratch and analyze their operational costs.",
    "Use recursion, function pointers and opaque interfaces appropriately.",
    "Build multi-file C programs with strong invariants, tests and error handling.",
    "Diagnose memory corruption, undefined behavior and performance problems systematically."
  ],
