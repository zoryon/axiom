  "schemaVersion": 1,
  "id": "rust-foundations",
  "code": "RS-101",
  "label": "Rust Foundations & Safe Systems Programming",
  "track": "Computer Science",
  "year": 1,
  "term": "2",
  "order": 80,
  "accent": "oxide",
  "recommendedHours": 90,
  "description": "Rust taught after exposure to C’s failure modes: ownership, borrowing, lifetimes, enums, traits, errors, iterators and safe systems programming with explicit comparisons to C.",
  "prerequisites": [
    "c-programming-1"
  ],
  "outcomes": [
    "Explain ownership and borrowing as compile-time models of resource lifetime and aliasing.",
    "Write idiomatic Rust using enums, pattern matching, Result, Option, traits and iterators.",
    "Relate Rust safety rules to concrete classes of C memory errors.",
    "Design small reusable crates with clear APIs and test coverage.",
    "Understand when unsafe code is necessary and what invariants it must preserve."
  ],
